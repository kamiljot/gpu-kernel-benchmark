# Doxyfile 1.9.x — Doxygen configuration for GPU Kernel Benchmark

# If you want to regenerate: doxygen Doxyfile

# Project info
PROJECT_NAME           = "GPU Kernel Benchmark"
PROJECT_BRIEF          = "Modular benchmarking suite for CPU/GPU kernels with auto-generated documentation"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO

# Input
INPUT                  = ./include ./src
FILE_PATTERNS          = *.h *.hpp *.cuh *.cpp *.cu
RECURSIVE              = YES
EXCLUDE                = */.git/* */build/* */benchmarks/* */external/*

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO

# Diagrams (if graphviz installed)
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg

# Source code browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
STRIP_CODE_COMMENTS    = NO

# Extraction
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

# Warnings
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

# Documentation style
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Repository/links (optional)
HTML_COLORSTYLE_HUE    = 210
HTML_DYNAMIC_SECTIONS  = YES

# Language support
EXTENSION_MAPPING      = cu=C++ cuh=C++

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO

# Misc
GENERATE_TREEVIEW      = YES

# Shortcuts
SHOW_USED_FILES        = YES

# If you want to support Python docstrings as well, add:
# FILE_PATTERNS         = *.h *.hpp *.cuh *.cpp *.cu *.py
# OPTIMIZE_OUTPUT_JAVA  = YES
# OPTIMIZE_OUTPUT_PYTHON= YES

